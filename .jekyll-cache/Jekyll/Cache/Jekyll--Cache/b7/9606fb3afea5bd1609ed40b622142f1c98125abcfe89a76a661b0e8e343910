I"L�{"source"=>"C:/Users/DaanB/Documents/GitHub/Human-Connection", "destination"=>"C:/Users/DaanB/Documents/GitHub/Human-Connection/_site", "collections_dir"=>"", "cache_dir"=>".jekyll-cache", "plugins_dir"=>"_plugins", "layouts_dir"=>"_layouts", "data_dir"=>"_data", "includes_dir"=>"_includes", "collections"=>{"posts"=>{"output"=>true, "permalink"=>"/:categories/:year/:month/:day/:title/"}, "team"=>{"output"=>true}}, "safe"=>false, "include"=>[".htaccess"], "exclude"=>[".sass-cache", ".jekyll-cache", "gemfiles", "Gemfile", "Gemfile.lock", "node_modules", "vendor/bundle/", "vendor/cache/", "vendor/gems/", "vendor/ruby/"], "keep_files"=>[".git", ".svn"], "encoding"=>"utf-8", "markdown_ext"=>"markdown,mkdown,mkdn,mkd,md", "strict_front_matter"=>false, "show_drafts"=>nil, "limit_posts"=>0, "future"=>false, "unpublished"=>false, "whitelist"=>[], "plugins"=>["jekyll-multiple-languages-plugin"], "markdown"=>"kramdown", "highlighter"=>"rouge", "lsi"=>false, "excerpt_separator"=>"\n\n", "incremental"=>false, "detach"=>false, "port"=>"4000", "host"=>"127.0.0.1", "baseurl"=>"//en", "show_dir_listing"=>false, "permalink"=>"pretty", "paginate_path"=>"/page:num", "timezone"=>nil, "quiet"=>false, "verbose"=>false, "defaults"=>[], "liquid"=>{"error_mode"=>"warn", "strict_filters"=>false, "strict_variables"=>false}, "kramdown"=>{"auto_ids"=>true, "toc_levels"=>[1, 2, 3, 4, 5, 6], "entity_output"=>"as_char", "smart_quotes"=>"lsquo,rsquo,ldquo,rdquo", "input"=>"GFM", "hard_wrap"=>false, "guess_lang"=>true, "footnote_nr"=>1, "show_warnings"=>false, "syntax_highlighter"=>"rouge", "syntax_highlighter_opts"=>{:default_lang=>"plaintext", :guess_lang=>true}, "coderay"=>{}}, "languages"=>["nl", "en"], "default_language"=>"nl", "exclude_from_localization"=>["assets", "admin", "js", "css", "images", "fonts"], "parallel_localization"=>true, "livereload_port"=>35729, "serving"=>true, "watch"=>true, "url"=>"http://localhost:4000", "exclude_from_localizations"=>[], "default_locale_in_subfolder"=>false, "default_lang"=>"nl", "lang"=>"en", "baseurl_root"=>"/", "translations"=>{"nl"=>{"nav"=>{"wat_wij_doen_url"=>"/wat-wij-doen/", "email_us"=>"Mail ons", "connect_to_perform_url"=>"/connect-to-perform/", "team_base_url"=>"/team/", "coaching_text"=>"Coaching", "werken_bij_url"=>"/werken-bij/", "wie_wij_zijn_text"=>"Wie wij zijn", "hoe_wij_werken_url"=>"/hoe-wij-werken/", "contact_text"=>"Contact", "vertrouwenspersoon_text"=>"Vertrouwenspersoon", "vertrouwenspersoon_url"=>"/vertrouwenspersoon/", "lang_nl"=>"NL", "home_url"=>"/", "contact_url"=>"/contact/", "ctp-contact"=>"/ctp-contact/", "hoe_wij_werken_text"=>"Hoe wij werken", "wie_wij_zijn_url"=>"/wie-wij-zijn/", "logo_alt_text"=>"Logo Human Connection", "coaching_url"=>"/coaching/", "werken_bij_text"=>"Werken bij ons", "lang_en"=>"EN", "connect_to_perform_text"=>"Connect to Perform", "wat_wij_doen_text"=>"Wat wij doen", "call_us"=>"Bel ons"}, "global"=>{"global.nederlands"=>"adsf", "global.english"=>"jkl;", "global.site_title"=>"jkl"}, "home"=>{"wat-wij-doen-3-tekst"=>"We begeleiden persoonlijke en professionele ontwikkeling voor bestuurders, leidinggevenden en professionals. Persoonlijk leiderschap en persoonlijke effectiviteit zijn hierbij belangrijke thema's.\n\nWe adviseren over de meest effectieve aanpak en ontwerpen en begeleiden workshops of trajecten zoals:\n\n* Ontwikkeltrajecten en opleidingsprogramma's \n* Leiderschapsprogramma's\n* Intervisie\n* [Individuele coaching](https://www.humanc.nl/coaching/)\n* Talentmanagement en traineeprogramma's \n* Inrichting van een effectieve leerinfrastructuur", "uitnodiging"=>"Of kom langs in ons pittoreske Amsterdamse kantoor:", "wie-wij-zijn"=>"Wie wij zijn", "actievraag-button"=>"Kom in contact met ons", "waar-wij-voor-staan"=>"Waar wij voor staan", "wat-wij-doen-1-contact"=>"**Meer weten?**\\\nNeem bijvoorbeeld contact op met Sjef of Zilla.", "partners-titel"=>"Samengewerkt met o.a.", "wat-wij-doen-2-contact"=>"**Meer weten?**\\\nNeem bijvoorbeeld contact op met Meggie of Dorothé.", "contact_org_name"=>"Human Connection", "wat-wij-doen-3-contact"=>"**Meer weten?**\\\nNeem contact op met bijvoorbeeld Marit of Annet.", "contact-placeholder"=>"Jouw antwoord", "contact-bericht"=>"Vraag/bericht", "contact_label_naam"=>"Naam*", "wat-wij-doen-1-titel"=>"Organisatieontwikkeling & teamontwikkeling", "wat-wij-doen-2-titel"=>"Interim management", "contact_label_bericht"=>"Vraag/Bericht*", "wat-wij-doen-3-titel"=>"Leren & ontwikkelen", "contact-naam"=>"Naam", "wat-wij-doen"=>"Wat wij doen", "postcode"=>"1013 GA Amsterdam", "wat-wij-doen-3-button"=>"Contact met Marit", "waarde-1-tekst"=>"Synergie ontstaat daar waar mensen verbonden zijn met zichzelf, met elkaar en met het doel van de organisatie. \n\nZelfbewustzijn, eigenaarschap, betrokkenheid en verantwoordelijkheid nemen zijn hierbij de kern. Daar staan we zelf voor en het is ook precies waar we onze klanten bij helpen. We nemen daarbij onze eigen persoonlijkheden, ervaringen en 'menselijkheid' mee in alles wat we doen.", "wat-wij-doen-2-button"=>"Contact met Meggie", "waarde-2-tekst"=>"Vertrouwen is voor ons de basis van waaruit we werken. Onderling als collega's en in samenwerking met onze klanten. Het is onze tweede natuur om waar we werken, te bouwen aan het vertrouwen tussen mensen onderling en in organisaties als geheel. \n\nWe benaderen mensen en hun vraagstukken positief: we koesteren uit principe veel vertrouwen in ieders goede intenties, mogelijkheden en veerkracht.", "wat-wij-doen-1-button"=>"Contact met Sjef", "contact-email"=>"E-mail", "landing-tekt"=>"Human Connection is een organisatieadviesbureau dat zich richt op de menselijke kant van organisaties. Vanuit verschillende rollen begeleiden we leiders, teams en individuele professionals om zich te ontwikkelen en proactiever (samen) te werken.\n\nWe werken altijd op maat, met een brede blik voor mensen in hun context, een gezonde bedrijfsvoering en de ontwikkeling van de organisatiecultuur.​ \n\nWe zijn ervaren in een breed werkveld, houden van een complexe uitdaging en kijken met een optimistische blik naar de mogelijkheden.", "waar-wijvoor-staan-tekst"=>"We doen wat we zeggen en zeggen wat we doen. Zowel hoe we onderling samenwerken in ons bedrijf, als hoe we samenwerken met onze opdrachtgevers. Wij werken altijd:", "waarde-3-tekst"=>"We bekijken iedere vraag, hoe groot of klein ook, met een brede blik. 'Wat is hier nou echt aan de hand? Welke patronen spelen hier?' \n\nJuist het samenspel tussen allerlei factoren (zoals de organisatie-inrichting, de manier van werken, de cultuur, de veranderende buitenwereld) bepalen het succes. Daarom sluiten we nauw aan bij de context van een organisatie en mensen en is alles wat we doen maatwerk.", "contact-onderwerp"=>"Onderwerp", "contact_label_email"=>"Email*", "contact-omschrijving"=>"We komen graag met je in contact. Bel of mail direct een van onze collega's of vul onderstaand formulier in.", "contact_label_onderwerp"=>"Onderwerp*", "hoe-wij-werken"=>"Meer weten over hóe wij werken?", "contact_placeholder"=>"Jouw antwoord", "pagina-afbeelding"=>"/assets/images/upload/parachute.jpg", "wat-wij-doen-3-link"=>"/team/marit-weiss/", "afbeelding-kantoor"=>"/assets/images/upload/kantoor.png", "wat-wij-doen-2-link"=>"/team/meggie-van-de-bunt/", "actievraag-subtitel"=>"Ontdek hoe wij hierbij kunnen helpen.", "wat-wij-doen-1-link"=>"/team/sjef-van-gool/", "waarde-3-afbeelding"=>"/assets/images/upload/icoon1dun.png", "contact-titel"=>"Contact", "waarde-1-titel"=>"In verbinding", "waarde-2-afbeelding"=>"/assets/images/upload/icoon2dun.png", "waarde-2-titel"=>"In vertrouwen", "wat-wij-doen-tekst"=>"We benaderen ieder vraagstuk met een organisatiebrede blik. Dit doen we vanuit een aantal expertises:", "waarde-1-afbeelding"=>"/assets/images/upload/icoon3dun.png", "contact_submit_button"=>"Verzend bericht", "waarde-3-titel"=>"In context", "adres"=>"Singel 2a", "actievraag"=>"Waar loop jij tegenaan in je organisatie?", "wat-wij-doen-1-tekst"=>"We adviseren en begeleiden teams en organisaties bij veranderingen. Via langere trajecten (blijvende cultuurverandering of reorganisaties), kortere interventies (teambuilding en proactief gedrag) en 'alles daartussenin'.\n\nVoorbeelden hiervan zijn: \n\n* Transformatie naar meer zelfsturing\n* Faciliteren verdiepende gesprekken en krachtige besluitvorming.\n* Cultuurontwikkeling: betere prestaties en een (pro)actievere cultuur.\n* Reorganisaties, fusies, samenwerkingsverbanden optimaliseren\n* Compliance en integriteitsvraagstukken\n* Invoeren en begeleiden van Agile/Scrum", "slogan"=>"Veranderen is mensenwerk", "wat-wij-doen-2-tekst"=>"Als interim-professional zijn we een tijdje onderdeel van de organisatie. Als manager of directeur zetten we, samen met de in de organisatie aanwezige strategische partners, initiatiefrijk een koers uit die in lijn ligt met het grotere geheel. Dit doen we graag in combinatie met een veranderopgave. \n\nWe doen dit bijvoorbeeld op het gebied van:\n\n* Verandermanagement\n* HR-management\n* Strategie-implementatie\n* ICT-management\n* L&O Professional", "contact-button"=>"Verzend bericht"}, "hoe-wij-werken"=>{"waar-wij-voor-staan"=>"Methoden en werkvormen", "landing-tekst"=>"Alles wat we doen is maatwerk, omdat elke verandering haar eigen dynamiek, complexiteit en tempo heeft.  \nWe hebben veel kennis in huis en zijn doorgewinterd in een aantal methodieken. Waar nodig zetten we deze in. Theorie en modellen gebruiken we als collectief begrippenkader en gemeenschappelijk taal. Het accent ligt bij ons altijd op directe toepasbaarheid in het dagelijkse werk.", "waarde-1-tekst"=>"Het begint bij persoonlijk contact. We bekijken samen met een opdrachtgever wat de context van de organisatie en de mensen op de werkvloer is. We kijken met een brede blik op het geheel: 'wat is hier nou echt aan de hand?'", "waarde-2-tekst"=>"Op basis daarvan geven we advies over een effectieve aanpak. Hierbij laten we de organisatie zoveel mogelijk zelf aan het stuur staan. We ontwerpen vooruit, het liefst samen met de mensen om wie het gaat. We scheppen realistische verwachtingen en kaders.", "waar-wijvoor-staan-tekst"=>"Voorbeelden van methoden en werkvormen zijn: Connect to Perform-cultuurontwikkeling, agile/scrum, deep democracy, zakelijk tekenen, Discovery Insights, Voice Dialogue, onomkeerbaar veranderen, ontwerpen met de leerinfrastructuur, diverse creatieve werkvormen \n\nOntwikkelingsgericht als we zijn, blijven we up to date met de nieuwste inzichten op het gebied van theorie en praktijk.", "waarde-3-tekst"=>"We begeleiden de uitvoering stap voor stap, zodat bijstelling altijd mogelijk is. We werken methodisch waar nodig. We begrijpen de dynamiek en complexiteit van organisaties en hebben ook altijd oog voor de individuele mens en zijn werk en privé context.", "waarde-4-tekst"=>"Juist op lastige momenten, of op het punt dat het juist te stil lijkt, helpen we om door te pakken.  We helpen de bewustwording om te zetten in actie op de werkvloer. Niet krampachtig vasthoudend aan het 'plan van een half jaar geleden', maar opnieuw in relatie tot de huidige koers en omstandigheden van de organisatie. Met de blik op lange termijn resultaat.​", "waarde-5-tekst"=>"Ontwikkeling is nooit 'af'. Wel vinden we het belangrijk dat onze klanten na onze begeleiding ook weer een tijd zelfstandig verder weten gaan. We helpen scherp te evalueren en te anticiperen op volgende ontwikkelingen. En we houden de lijn voor een even sparren of bijpraten altijd open.", "pagina-afbeelding"=>"/assets/images/upload/impact.jpg", "waarde-5-afbeelding"=>"", "waarde-4-afbeelding"=>"", "waarde-3-afbeelding"=>"", "title"=>"Hoe wij werken", "waarde-1-titel"=>"1. Contact en context", "waarde-2-afbeelding"=>"", "waarde-2-titel"=>"2. Pragmatisch ontwerp en advies", "waarde-1-afbeelding"=>"", "waarde-3-titel"=>"3.  Begeleiding", "waarde-4-titel"=>"4. Doorpakken tot het echt werkt​", "waarde-5-titel"=>"5. Evalueren"}, "connect-to-perform"=>{"button2"=>"Meld je hier aan voor de open spelavond", "landing-tekst"=>"‘Connect to Perform’ is het gedachtegoed dat de basis vormt voor Human Connection’s advieswerk. Het demonstreert hoe teams en organisaties naar een meer effectieve én prettige werkwijze te bewegen zijn door (onderlinge) verbinding te maken. Om de brug te slaan tussen ’theorie’ en ‘zelf toepassen’, hebben we een spel ontworpen wat met groot succes in organisaties en op onze open avonden gespeeld wordt.", "more-info"=>"/assets/images/upload/connect_to_perform.pdf", "werkvorm-tekst"=>"Als kennismaking organiseren we een aantal keer per jaar een open spelavond, tegenwoordig veelal online, waarop onze relaties en geïnteresseerden welkom zijn kennis te maken met deze methodiek. (deelname geheel gratis en zonder verdere verplichtingen) Via een inlog in ons online leerportaal krijg je toegang tot video’s met uitleg en achtergrondinformatie. Bovendien leert de ervaring dat het erg interessant is van gedachten te wisselen met mensen die je nog niet kende, werkzaam in diverse organisaties.\n\nIn organisaties spelen we het spel (online of offline) in MT-trajecten of leiderschapsprogramma’s. We hebben verschillende werkvormen, afhankelijk van tijd en interesse van de doelgroep en passen het spel ook inhoudelijk op maat aan waar nodig. De vertaling naar de werkcontext, in het licht van de strategie van de organisatie en tevens de concretisering ‘wat ga ik er morgen mee doen’ zijn belangrijke onderdelen in de nabespreking en eventuele follow-up.\n\nOok is het spel aan te vragen als losse workshop. Denk daarbij aan een halve of hele dag, online of offline voor een groep van 4 tot 80 deelnemers. Stuur voor meer informatie svp een mail naar Jojanneke van Goïnga.\n", "methoden"=>"Connect to Perform Cultuurontwikkeling", "werkwijze-tekst"=>"Tijdens het spel krijg je aan de hand van een fictieve situatie inzicht in de methodiek en mogelijke interventies om de organisatiecultuur en prestaties te ontwikkelen. Er wordt helder hoe je kunt signaleren in welke ontwikkelfase een organisatie (of team)cultuur zich bevindt. Op basis van voorbeelden uit de praktijk zie je spelenderwijs in wat er nodig is om de volgende ontwikkelstap te maken en wat juist zaken zijn die averechts uitpakken.\n\nJe krijgt zicht op zo’n vijftig verschillende interventies die toepasbaar zijn in de werkpraktijk, om het gedrag en de cultuur van een team en organisatie te beïnvloeden. Kortom, in een paar uur wordt je op interactieve wijze ondergedompeld in onze succesvolle aanpak hoe je meer impact met je team maakt.", "pagina-illustratie"=>"/assets/images/upload/connect-to-perform-ingevuld.jpg", "werkvorm-titel"=>"Open spelavond", "pagina-afbeelding"=>"/assets/images/upload/verandering-transitie.jpg", "werkwijze-titel"=>"Connect to Perform: het spel ", "methoden-tekst"=>" ", "title"=>"Connect to Perform", "button1"=>"Meer weten over Connect to Perform"}, "vertrouwenspersoon"=>{"title"=>"Vertrouwenspersoon", "landing-tekst"=>"**Vertrouwenspersoon en preventie als prioriteit voor een sociaal veilige werkplek**\n\nIn een tijd waarin de nadruk steeds meer komt te liggen op het **creëren van een gezond en plezierig werkklimaat**, rijst de vraag: hoe kunnen organisaties **een veilige omgeving waarborgen voor hun medewerkers?** Het benoemen van een (interne) vertrouwenspersoon is voor bedrijven een veel gekozen **eerste stap.** Om daadwerkelijk een veilige werkomgeving te creëren en houden, zijn daarnaast **bredere maatregelen en soms zelfs een cultuurverandering nodig.** \n\nHet **integreren van sociale veiligheid op de werkplek** blijkt namelijk een cruciale factor te zijn in het streven naar **een duurzaam gezonde organisatie.** \n\nAls er een **prettig leer- en werkklimaat is, zijn de resultaten beter, wordt er effectiever gewerkt en is er meer innovatie** mogelijk is. Maar wat houdt dit precies in, en hoe kunnen organisaties dit realiseren?", "pagina-afbeelding"=>"/assets/images/upload/sociale-veiligheid.webp", "pagina-titel"=>"Vertrouwenspersoon", "vertrouwenspersoon-tekst"=>"### Wat is een sociaal veilige werkplek?\n\nIedere werkplek is anders, iedere bedrijfscultuur is anders. Toch is er een aantal elementen waaraan je herkent dat er sprake is van een sociaal veilige werkplek:\n\n* Medewerkers uiten zich makkelijk. \n* Ze praten óok over knelpunten in de uitvoering van hun werk.\n* Ze praten open en vrij.\n* Ze spreken zich uit zonder angst voor de gevolgen.\n\n### Brede, systemische benadering \n\nHuman Connection onderscheidt zich door een bredere benadering van het creëren van een sociale veilige werkplek, waarbij een vertrouwenspersoon een essentieel onderdeel vormt. \n\nDe focus ligt op preventieve maatregelen, naast het bieden van hulp bij contextanalyse, interventies en begeleiding, mocht het toch tot escalatie komen. We doen dit met een doordachte en systemische aanpak die we al sinds 1998 gebruiken en doorontwikkelen. Kijk voor meer informatie [hier](https://www.humanc.nl/hoe-wij-werken/).\n\n### Human Connection biedt:\n\n* Gecertificeerde vertrouwenspersonen\n* Ieder vertrouwenspersoon brengt minimaal een extra expertise mee\n* Vervanging bij ziekte of vakantie\n* Onderlinge intervisie, ontsluit een nog breder perspectief op kwesties\n* Ervaring met het betrekken van de hele organisatie bij start, vervolg en executie van (verander)traject.  \n\n### Meer weten?\n\nWil je meer weten over hoe Human Connection kijkt naar de rol van vertrouwenspersoon en preventie als prioriteit binnen een gezonde werkplek? Download hier ons whitepaper met sleutelfactoren van een sociaal veilige werkomgeving."}, "coaching"=>{"title"=>"Coaching", "landing-tekst"=>"Wil je meer zelfinzicht, meer grip op je aanpak van bepaalde zaken, af van bepaalde patronen, of concrete tools om in je werk effectiever te zijn?\n\nMet individuele coaching helpen we je op maat. Op een manier (live, buiten, online, on the job) en ritme (een snelle boost of liever een rustiger, wat langer traject?) die bij jou past.\n\nOp basis van een intake kies je de coach die bij jou past en met diegene bepaal je hoe het coachtraject eruit ziet. Elk coachtraject stemmen we af op jouw behoeften, doelen en context. Enerzijds gaat dat over verdieping: wat is de achtergrond van je coachvraag? En anderzijds over praktische toepassing: de inzichten die je opdoet vertalen naar jouw leven en werk.\n\nWe coachen van werkvloer tot en met executive level. Onafhankelijk en vertouwelijk. Het kan gekoppeld zijn aan een organisatie-ontwikkeltraject of leiderschapsontwikkeling. Maar ook voor mensen die individueel op zoek zijn naar meer balans of een volgende loopbaanstap.", "pagina-afbeelding"=>"/assets/images/upload/kompas.jpg", "pagina-titel"=>"Coaching", "coaching-tekst"=>"**Coachthema’s**\n\nHet doel en thema van het coachtraject is altijd individueel bepaald en vaak een combinatie van meerdere elementen. In de praktijk werken wij veel met de volgende themas:\n\n* Persoonlijke ontwikkeling \n* Communicatie \n* Balans en veerkracht | stress, burn-out \n* Loopbaanontwikkeling\n\n**Methoden en vormen**\n\nWe werken met methoden en materialen uit verschillende managementtheorieën, psychologie en stromingen zoals Voice Dialogue, Co-active coaching, ACT, Insights en Deep Democracy.\n\nIn een coachtraject kunnen verschillende gespreksvormen en elementen worden ingezet, zoals: gesprekken (live, online of wandelend), verdiepingsopdrachten, praktijkopdrachten, coaching on the job, driegesprekken met de leidinggevende, leesmateriaal, achtergrondartikelen, reflectieopdrachten, testen en video’s.\n\n**Altijd op maat**\n\nWe helpen je inzicht te krijgen in je gedragspatronen, je comfortzone te verkennen en duurzame veranderingen door te voeren. Zo werk je niet alleen aan je professionele groei, maar ook aan een gezondere balans en meer veerkracht.\n\nAan een ‘standaardtraject’ doen wij dus niet. Het is geen kwestie van ‘doe me module 2 en gespreksvorm x'. We kijken juist samen met jou wat werkt. In jouw context, met jouw doelen, wensen en eigen wijsheid.\n\n**De coaches**\n\nEen groot aantal van onze collega’s is professioneel coach. We hebben allemaal onze eigen achtergrond en stijl. Waar we in overeenkomen is dat we staan voor professionaliteit, vertrouwelijkheid en de brede blik op de mens, in zijn context.\n\nHieronder vind je de namen van collega’s die coachen: [Marit](https://www.humanc.nl/team/marit-weiss/), [Anne](https://www.humanc.nl/team/anne-boertien/), [Jojanneke](https://www.humanc.nl/team/jojanneke-van-goinga/), [Meggie,](https://www.humanc.nl/team/meggie-van-de-bunt/) [Alexander, ](https://www.humanc.nl/team/alexander-van-ravesteyn/)[Gerke,](https://www.humanc.nl/team/gerke-visser/) [Petra,](https://www.humanc.nl/team/petra-berry/) [Willemijn](https://www.humanc.nl/team/willemijn-dekker/),[ Zilla](https://www.humanc.nl/team/zilla-uiterwijk/) en [Sjef.](https://www.humanc.nl/team/sjef-van-gool/)\n\n**Interesse?**\n\nNeem direct contact op met een van onze collega's, of voor meer informatie neem contact op met [Marit.](https://www.humanc.nl/team/marit-weiss/)"}, "ctp-contact"=>{"success"=>"Dankjewel voor je bericht!", "landing-tekst"=>"Als kennismaking organiseren we een aantal keer per jaar een open spelavond, tegenwoordig veelal online, waarop onze relaties en geïnteresseerden welkom zijn kennis te maken met deze methodiek. (deelname geheel gratis en zonder verdere verplichtingen) Via een inlog in ons online leerportaal krijg je toegang tot video’s met uitleg en achtergrondinformatie. Bovendien leert de ervaring dat het erg interessant is van gedachten te wisselen met mensen die je nog niet kende, werkzaam in diverse organisaties.", "telefoonnummer"=>"Telefoonnummer*", "data"=>[{"datum"=>"Maandag 6 oktober: 19:30-21:45"}], "functie"=>"Functie*", "aanmelding-title"=>"Aanmeldformulier Spelavond", "aanmelding-tekst"=>"Vul hier je gegevens in om je aan te melden voor de spelavond.", "button-submit"=>"Verzend formulier", "bedrijf"=>"Bedrijf*", "button-reset"=>"Formulier wissen", "pagina-afbeelding"=>"/assets/images/upload/verandering-transitie.jpg", "success-text"=>"Bedankt voor je aanmelding, leuk dat je erbij bent! \nVoor nu hoef je niets te doen, behalve de datum in je agenda te zetten. \nOngeveer een week van te voren ontvang je een voorbereidingsmail met meer informatie. \nHeb je voor die tijd vragen, neem dan contact op met jojanneke@humanc.nl", "button-terug"=>"Terug naar de homepage", "welke"=>"Voor welke avond meld je je aan?*", "placeholder-answer"=>"Jouw antwoord", "title"=>"Connect to perform", "reden"=>"Wat is je reden van aanmelden?", "aanmelding-zoom"=>" ", "email"=>"Email*", "hoe"=>"Via wie of hoe weet je van de Connect to Perform avond?", "naam"=>"Naam*"}, "werken-bij"=>{"contact"=>"Neem contact op met Meggie via [meggie@humanc.nl](#) of 06 50 83 56 58.", "landing-tekst"=>"We zoeken iemand die met zelfvertrouwen en een frisse blik voor de groep kan staan en ook in staat is individuele coachgesprekken te voeren. Je frisse blik en creativiteit zijn van harte welkom, evenals je vermogen om, ongeacht de omstandigheden, op een constructieve manier om te gaan met groepsdynamiek. Je blik is breder dan persoonlijke ontwikkeling alleen, je hebt interesse in organisatie ontwikkeling, van strategie tot uitvoering en bent eager om daar meer over te leren.", "wat-je-doet"=>"Wat doe je als?", "wat-we-bieden"=>"Dit bieden we je ook", "kop"=>"Als coach/begeleider van ontwikkelprogramma’s", "pagina-afbeelding"=>"/assets/images/upload/parachute.jpg", "wat-je-doet-tekst"=>"Je maakt op maat programma’s waarin medewerkers en managers van organisaties zich kunnen ontwikkelen. Denk hierbij als een jaartraject ‘Persoonlijk Leiderschap’, een ‘Masterclass-traject voor talent’ of andere vormen van trainee- of leiderschapsprogramma’s.\n\nWe zoeken iemand die met zelfvertrouwen en een frisse blik voor de groep kan staan en ook in staat is individuele coachgesprekken te voeren. Je frisse blik en creativiteit zijn van harte welkom, evenals je vermogen om, ongeacht de omstandigheden, op een constructieve manier om te gaan met groepsdynamiek. Je blik is breder dan persoonlijke ontwikkeling alleen, je hebt interesse in organisatie ontwikkeling, van strategie tot uitvoering en bent eager om daar meer over te leren. Je kunt goed samenwerken en bent tegelijkertijd autonoom genoeg om in onze kleinschalige, platte organisatie je eigen weg te vinden. Het spiegelen van klanten, collega’s en ook de spotlight op jezelf richten, vind je een mooie uitdaging.", "uitzendbureaus"=>"Uitzend- of wervingsbureaus hoeven niet op deze vacature te reageren.", "title"=>"Werken bij", "wat-we-bieden-tekst"=>"* Een salaris dat past bij jouw kennis en ervaring. \n* Een eindejaarsbonus op basis van de gezamenlijk gemaakte winst. \n* Een laptop, telefoon, 1e klas OV kaart, alles wat je nodig hebt om goed hybride te werken en goede secundaire voorwaarden. \n* Een kantoor in hartje Amsterdam, 2 minuten lopen vanaf CS (waar je alleen hoeft te zijn als je samen met collega’s aan opdrachten werkt).", "vacature-open"=>false}}, "en"=>{"nav"=>{"wat_wij_doen_url"=>"/what-we-do/", "succes_url"=>"/success/", "email_us"=>"Email us", "connect_to_perform_url"=>"/connect-to-perform/", "team_base_url"=>"/team/", "coaching_text"=>"Coaching", "werken_bij_url"=>"/work-with-us/", "wie_wij_zijn_text"=>"Who we are", "hoe_wij_werken_url"=>"/how-we-work/", "contact_text"=>"Contact", "vertrouwenspersoon_text"=>"Confidential Advisor", "vertrouwenspersoon_url"=>"/confidential-advisor/", "lang_nl"=>"NL", "home_url"=>"/", "contact_url"=>"/contact/", "ctp-contact"=>"/ctp-contact/", "hoe_wij_werken_text"=>"How we work", "wie_wij_zijn_url"=>"/who-we-are/", "logo_alt_text"=>"Human Connection Logo", "coaching_url"=>"/coaching/", "werken_bij_text"=>"Work with us", "lang_en"=>"EN", "connect_to_perform_text"=>"Connect to Perform", "wat_wij_doen_text"=>"What we do", "call_us"=>"Call us"}, "global"=>{"nederlands"=>"Dutch", "english"=>"English", "site_title"=>"Human Connection", "global.nederlands"=>"Nederlands", "global.english"=>"english", "global.site_title"=>"Human_connection"}, "home"=>{"wat-wij-doen-3-tekst"=>"We guide personal and professional development for executives, managers, and professionals. Personal leadership and personal effectiveness are important themes here.\n\nWe advise on the most effective approach and design and facilitate workshops or programs such as:\n\n* Development trajectories and training programs  \n* Leadership programs  \n* Intervision (Peer consultation)  \n* [Individual coaching](https://www.humanc.nl/en/coaching/)  \n* Talent management and trainee programs  \n* Setting up an effective learning infrastructure", "uitnodiging"=>"Or visit us at our picturesque Amsterdam office:", "wie-wij-zijn"=>"Who we are", "actievraag-button"=>"Get in touch with us", "waar-wij-voor-staan"=>"What we stand for", "wat-wij-doen-1-contact"=>"**Want to know more?**\\\nPlease contact Sjef or Zilla.", "partners-titel"=>"Worked with, among others:", "wat-wij-doen-2-contact"=>"**Want to know more?**\\\nPlease contact Meggie or Dorothé.", "contact_org_name"=>"Human Connection", "wat-wij-doen-3-contact"=>"**Want to know more?**\\\nPlease contact Marit or Annet.", "contact-placeholder"=>"Your answer", "contact-bericht"=>"Question/Message", "contact_label_naam"=>"Name*", "wat-wij-doen-1-titel"=>"Organizational development & team development", "wat-wij-doen-2-titel"=>"Interim Management", "contact_label_bericht"=>"Question/Message*", "wat-wij-doen-3-titel"=>"Learning & Development", "contact-naam"=>"Name", "wat-wij-doen"=>"What we do", "postcode"=>"1013 GA Amsterdam", "wat-wij-doen-3-button"=>"Contact Marit", "waarde-1-tekst"=>"Synergy arises where people are connected with themselves, with each other, and with the purpose of the organization.\n\nSelf-awareness, ownership, engagement, and taking responsibility are central to this. We stand for this ourselves, and this is also exactly what we help our clients with. We bring our own personalities, experiences, and 'humanity' to everything we do.", "wat-wij-doen-2-button"=>"Contact Meggie", "waarde-2-tekst"=>"For us, trust is the foundation from which we work. Amongst colleagues and in collaboration with our clients. It is our second nature, to build trust between people and within organizations wherever we work. We approach people and their issues positively: we inherently trust everyone's good intentions, capabilities, and resilience.", "wat-wij-doen-1-button"=>"Contact Sjef", "contact-email"=>"E-mail", "landing-tekt"=>"Human Connection is a management consultancy that focuses on the human side of organizations. In various roles, we guide leaders, teams, and individual professionals to develop and work more proactively(together).\n\nWe work in a tailor-made manner, taking into account each specificity of the project an taking a with a broad view of people in their context, healthy business operations, and the development of organizational culture.\n\nOur experience is wide-ranging. We love a complex challenge, and look at opportunities with an optimism.", "waar-wijvoor-staan-tekst"=>"We do what we say and say what we do. Both in how we collaborate internally within our company, and how we collaborate with our clients. We always work:", "waarde-3-tekst"=>"We take a broad view of every question and ask ourselves: 'What is really going on here? What patterns are at play?'\n\nThe interplay between various factors (such as organizational structure, way of working, culture, the changing external world) determines success. Therefore, we closely align with the context of an organization and people, and everything we do is tailor-made.", "contact-onderwerp"=>"Subject", "contact_label_email"=>"Email*", "contact-omschrijving"=>"We would like to get in touch with you. Call or email one of our colleagues directly, or fill in the form below.", "contact_label_onderwerp"=>"Subject*", "hoe-wij-werken"=>"Want to know more about how we work?", "contact_placeholder"=>"Your answer", "pagina-afbeelding"=>"/assets/images/upload/parachute.jpg", "wat-wij-doen-3-link"=>"/team/marit-weiss/", "afbeelding-kantoor"=>"/assets/images/upload/kantoor.png", "wat-wij-doen-2-link"=>"/team/meggie-van-de-bunt/", "actievraag-subtitel"=>"Discover how we can help with this.", "wat-wij-doen-1-link"=>"/team/sjef-van-gool/", "waarde-3-afbeelding"=>"/assets/images/upload/icoon1dun.png", "contact-titel"=>"Contact", "waarde-1-titel"=>"In Connection", "waarde-2-afbeelding"=>"/assets/images/upload/icoon2dun.png", "waarde-2-titel"=>"In Trust", "wat-wij-doen-tekst"=>"We approach every issue with an organization-wide perspective. We do this from several areas of expertise:", "waarde-1-afbeelding"=>"/assets/images/upload/icoon3dun.png", "contact_submit_button"=>"Send message", "waarde-3-titel"=>"In Context", "adres"=>"Singel 2a", "actievraag"=>"What challenges are you facing in your organization?", "wat-wij-doen-1-tekst"=>"We advise and guide teams and organizations through changes. Through longer trajectories (lasting cultural change or reorganizations), shorter interventions (teambuilding and proactive behavior), and everything in between.\n\nExamples include:\n\n* Transformation to more self-management  \n* Facilitating in-depth conversations and powerful decision-making.  \n* Culture development: better performance and a more (pro)active culture.  \n* Reorganizations, mergers, optimizing collaborations  \n* Compliance and integrity issues  \n* Implementing and guiding Agile/Scrum", "slogan"=>"Change is human work", "wat-wij-doen-2-tekst"=>"As interim professionals, we are part of the organization for a while. As managers or directors, we, together with the strategic partners present in the organization, proactively set a course that aligns with the bigger picture. We enjoy doing this in combination with a change assignment.\n\nWe do this, for example, in the areas of:\n\n* Change management  \n* HR management  \n* Strategy implementation  \n* ICT management  \n* L&D professional", "contact-button"=>"Send Message"}, "hoe-wij-werken"=>{"waar-wij-voor-staan"=>"Methods and formats", "landing-tekst"=>"Everything we do is tailor-made, because every change has its own dynamics, complexity, and pace.\n\nWe have extensive knowledge and have vast experience in several methodologies. We use theories and models as a collective frame of reference and common language. The emphasis for us is always on direct applicability in daily work.", "waarde-1-tekst"=>"It starts with personal contact. Together with a client, we look at the context of the organization and the people on the work floor is. We look with a broad view on the whole: 'what is really going on here?'", "waarde-2-tekst"=>"Based on the intake, we advise on an effective approach. We let the organization take the lead as much as possible. We design and plan ahead, preferably together with the people involved. We create realistic expectations and frameworks.", "waar-wijvoor-staan-tekst"=>"Examples of methods and formats are: Connect to Perform culture development, agile/scrum, Deep Democracy, business drawing, Insights Discovery, Voice Dialogue, irreversible change, Lencioni, Scaling Up, designing with the learning infrastructure, various creative formats\n\nDevelopment-oriented as we are, we stay up to date with the latest insights in theory and practice.", "waarde-3-tekst"=>"We guide the implementation step by step, so that adjustment is always possible. We work methodically where necessary. We understand the dynamics and complexity of organizations and always have an eye for the individual and their work and private context.", "waarde-4-tekst"=>"Especially at difficult moments, or when things seem too quiet, we help to push through.  We help turn awareness into action on the work floor. Not clinging rigidly to the 'plan from six months ago', but again in relation to the current course and circumstances of the organization. With a focus on long-term results.​", "waarde-5-tekst"=>"Development is never finished. However, we find it important that our clients can continue independently for a while after our guidance. We help to evaluate sharply and anticipate future developments. And we always keep the line open for a quick chat or catch-up.", "pagina-afbeelding"=>"/assets/images/upload/impact.jpg", "waarde-5-afbeelding"=>"", "waarde-4-afbeelding"=>"", "waarde-3-afbeelding"=>"", "title"=>"How we work", "waarde-1-titel"=>"1. Contact and context", "waarde-2-afbeelding"=>"", "waarde-2-titel"=>"2. Pragmatic design and advice", "waarde-1-afbeelding"=>"", "waarde-3-titel"=>"3.  Guidance", "waarde-4-titel"=>"4. Pushing through until it really works​", "waarde-5-titel"=>"5. Evaluating"}, "connect-to-perform"=>{"button2"=>"Sign up here for the open game evening", "landing-tekst"=>"'Connect to Perform' is the philosophy that forms the basis for Human Connection's consultancy work. It demonstrates how teams and organizations can move to a more effective and pleasant way of working by making (mutual) connections. To bridge the gap between 'theory' and 'self-application', we have designed a game that is played with great success in organizations and during our open evenings.", "more-info"=>"/assets/images/upload/connect_to_perform.pdf", "werkvorm-tekst"=>"As an introduction, we organize an open game evening several times a year, nowadays mostly online, where our relations and interested parties are welcome to get acquainted with this methodology. (participation is completely free and without further obligations). Moreover, experience shows that it is very interesting to exchange thoughts with people you didn't know before and who are working in different organizations. When you partcipate, you will get access to videos with explanations and background information. \n\nIn organizations, we play the game (online or offline) in MT trajectories or leadership programs. We have different formats, depending on the time and interest of the target group, and we also tailor the game content where necessary. The translation to the work context, in light of the organization's strategy, and the concretization 'what will I do with it tomorrow' are important parts of the debriefing and possible follow-up.\n\nThe game can also be requested as a standalone workshop. Think of a half or full day, online or offline, for a group of 4 to 80 participants. For more information, please send an email to Jojanneke.", "methoden"=>"Connect to Perform Culture Development", "werkwijze-tekst"=>"During the game, using a fictional situation, you will gain insight into the methodology and possible interventions to develop organizational culture and performance. You will learn how you can identify which development phase an organization (or team) culture is in. Based on practical examples, you will find out what is needed to take the next development step and what interventions have a counterproductive effect.\n\nYou will gain insight into some fifty different interventions that can be applied in the work practice, to influence the behavior and culture of a team and organization. In short you will be immersed \ninteractively in our successful approach on how to make more impact with your team in a few hours.", "pagina-illustratie"=>"/assets/images/upload/connect-to-perform-ingevuld.jpg", "werkvorm-titel"=>"Open Game Evening", "pagina-afbeelding"=>"/assets/images/upload/verandering-transitie.jpg", "werkwijze-titel"=>"Connect to Perform: the game ", "methoden-tekst"=>" ", "title"=>"Connect to Perform", "button1"=>"Learn more about Connect to Perform"}, "vertrouwenspersoon"=>{"title"=>"Confidential advisor", "landing-tekst"=>"**Confidential advisor and prevention as a priority for a socially safe workplace**\n\nAt a time during which the emphasis is increasingly placed on creating a healthy and pleasant work climate, the question arises: how can organizations ensure a safe environment for their employees? Appointing an (internal) confidential advisor is a commonly chosen first step for companies. To actually create and maintain a safe working environment, broader measures and sometimes even a culture change are needed.\n\nIntegrating social safety in the workplace turns out to be a crucial factor in striving for a sustainably healthy organization.\n\nIf there is a pleasant learning and working climate, results are better, work is done more effectively, and there is more opportunity for innovation. But what exactly does this entail, and how can organizations achieve this?", "pagina-afbeelding"=>"/assets/images/upload/sociale-veiligheid.webp", "pagina-titel"=>"Confidential Advisor", "vertrouwenspersoon-tekst"=>"### What is a socially safe workplace?\n\nEvery workplace is different, every corporate culture is different. However, there are a number of elements that indicate a socially safe workplace:\n\n* Employees express themselves easily.  \n* They *also* talk about bottlenecks in the execution of their work.  \n* They talk openly and freely.  \n* They speak out without fear of consequences.\n\n### Broad, systemic approach\n\nHuman Connection distinguishes itself by a broader approach to creating a socially safe workplace, where a confidential advisor is an essential part.\n\nThe focus is on preventive measures, in addition to providing help with context analysis, interventions, and guidance, should escalation occur. We do this with a well-thought-out and systemic approach that we have been using and further developing since 1998. For more information, look [here](https://www.humanc.nl/en/how-we-work/).\n\n### Human Connection offers:\n\n* Certified confidential advisors  \n* Each confidential advisor brings at least one additional expertise  \n* Replacement during illness or vacation  \n* Mutual intervision (peer consultation), unlocks an even broader perspective on issues  \n* Experience in involving the entire organization at the start, continuation, and execution of (change) trajectories.\n\n### Want to know more?\n\nDo you want to know more about how Human Connection views the role of the confidential advisor and prevention as a priority within a healthy workplace? Download our whitepaper (Dutch) here with key factors for a socially safe working environment."}, "coaching"=>{"title"=>"Coaching", "landing-tekst"=>"Do you want more self-insight, more control over your approach to certain matters, to get rid of certain patterns, or concrete tools to be more effective in your work?\n\nWith individual coaching, we help you in a way (live, outdoors, online, on the job) and rhythm (a quick boost or rather a calmer, somewhat longer trajectory) that suits you.\n\nBased on an intake, you will choose the coach that suits you, and jointly  determine what the coaching trajectory will look like for you. The coaching trajectory will be tailored to your needs, goals, and context. On one hand, this involves depth: what is the background of your coaching question? And on the other hand, about practical application: translating the insights you will gain into your life and work.\n\nWe coach from the work floor up to the executive level. Independently and confidentially. Coaching trajectories can be linked to an organizational development trajectory or a leadership program. But also for individuals looking for more balance or the next career step.", "pagina-afbeelding"=>"/assets/images/upload/kompas.jpg", "pagina-titel"=>"Coaching", "coaching-tekst"=>"**Coaching Themes**\n\nThe goal and theme of the coaching trajectory are always individually determined and often a combination of several elements. In practice, we often work with the following themes:\n\n* Personal development  \n* Communication  \n* Balance and resilience \n* Stress, burn-out  \n* Career development\n\n**Methods and formats**\nWe work with methods and materials from various management theories, psychology, and approaches such as Voice Dialogue, Co-active coaching, ACT, Insights Benelux, and Deep Democracy.\nIn a coaching trajectory, various conversation forms and elements can be used, such as: conversations (live, online, or walking), deepening assignments, practical assignments, coaching on the job, three-way conversations with the manager, reading material, background articles, reflection assignments, tests, and videos.\n\n**Always tailor-made**\nWe help you gain insight into your behavioral patterns, explore your comfort zone, and implement sustainable changes. This way, you will not only work not on your professional growth but also on achieving a healthier balance and more resilience.\n\nSo, we don't do 'standard programs'. It's not a matter of 'give me module 2 and session type x'. Instead, we look together with you at what works. In your context, with your goals, wishes, and own wisdom.\n\n**The coaches**\nA large number of our colleagues are professional coaches. We all have our own background and style. What we have in common is that we stand for professionalism, confidentiality, and a broad view of the person, in their context.\n\nBelow you will find the names of colleagues who coach: \n[Marit](https://www.humanc.nl/en/team/marit-weiss/), [Anne](https://www.humanc.nl/en/team/anne-boertien/), [Jojanneke](https://www.humanc.nl/en/team/jojanneke-van-goinga/), [Meggie,](https://www.humanc.nl/en/team/meggie-van-de-bunt/) [Alexander, ](https://www.humanc.nl/en/team/alexander-van-ravesteyn/)[Gerke,](https://www.humanc.nl/en/team/gerke-visser/) [Petra,](https://www.humanc.nl/en/team/petra-berry/) [Willemijn](https://www.humanc.nl/en/team/willemijn-dekker/), [Zilla](https://www.humanc.nl/en/team/zilla-uiterwijk/) and [Sjef.](https://www.humanc.nl/en/team/sjef-van-gool/)\n\n**Interested?**\nContact one of our colleagues directly, or for more information contact [Marit.](https://www.humanc.nl/en/team/marit-weiss/)"}, "ctp-contact"=>{"success"=>"Thank you for registering!", "landing-tekst"=>"As an introduction, we organize an open game evening several times a year, nowadays mostly online, where our relations and interested parties are welcome to get to know this methodology. (Participation is completely free and without further obligations).  Experience shows it's very interesting to exchange thoughts with people you haven't met before, working in various organizations. \nIf you participate you gain access to videos with explanations and background information. You are very welcome!", "telefoonnummer"=>"Phone Number*", "data"=>[{"datum"=>"Monday October 6th: 19:30-21:45"}], "functie"=>"Position*", "aanmelding-title"=>"Game Evening Registration Form", "aanmelding-tekst"=>"Fill in your details here to register for the game evening.", "button-submit"=>"Send form", "bedrijf"=>"Company*", "button-reset"=>"Reset form", "pagina-afbeelding"=>"/assets/images/upload/verandering-transitie.jpg", "success-text"=>"Thanks for registering, we're happy you'll be joining!\n\nFor now, you don't need to do anything except put the date in your calendar.\n\nAbout a week beforehand, you will receive a preparation email with more information.\n\nIf you have any questions before then, please contact jojanneke@humanc.nl", "button-terug"=>"Back to the homepage", "welke"=>"Which evening are you registering for?*", "placeholder-answer"=>"Your answer", "title"=>"Connect to perform", "reden"=>"What is your reason for registering?", "aanmelding-zoom"=>" ", "email"=>"Email*", "hoe"=>"Via whom or how did you hear about the Connect to Perform evening?", "naam"=>"Name*"}, "werken-bij"=>{"contact"=>"Contact Meggie via [meggie@humanc.nl](#) or 06 50 83 56 58.", "landing-tekst"=>"We are looking for someone who can stand in front of a group with self-confidence and a fresh perspective, and is also capable of conducting individual coaching sessions. Your fresh perspective and creativity are very welcome, as is your ability to, regardless of the circumstances, deal constructively with group dynamics. Your perspective is broader than personal development alone; you are interested in organizational development, from strategy to execution, and are eager to learn more about it.", "wat-je-doet"=>"What you'll Do:", "wat-we-bieden"=>"What We Offer You:", "kop"=>"As coach/facilitator of development programs", "pagina-afbeelding"=>"/assets/images/upload/parachute.jpg", "wat-je-doet-tekst"=>"You create custom programs in which employees and managers of organizations can develop themselves. Think of a year-long trajectory 'Personal Leadership', a 'Masterclass trajectory for talent', or other forms of trainee or leadership programs.\n\nWe are looking for someone who can stand in front of a group with self-confidence and a fresh perspective, and is also capable of conducting individual coaching sessions. Your fresh perspective and creativity are very welcome, as is your ability to, regardless of the circumstances, deal constructively with group dynamics. Your perspective is broader than personal development alone; you are interested in organizational development, from strategy to execution, and are eager to learn more about it. You can collaborate well and are simultaneously autonomous enough to find your own way in our small-scale, flat organization. Mirroring clients, colleagues, and also turning the spotlight on yourself, you find an appealing challenge.", "uitzendbureaus"=>"Temporary employment or recruitment agencies need not respond to this vacancy.", "title"=>"Working at", "wat-we-bieden-tekst"=>"* A salary that matches your knowledge and experience. \n\n* An end-of-year bonus based on the profit made together. \n\n* A laptop, phone, 1st class public transport card, everything you need to work well hybridly, and good secondary benefits. \n\n* An office in the heart of Amsterdam, a 2-minute walk from CS (Central Station) (where you only need to be when working on assignments with colleagues).", "vacature-open"=>false}}}}:ET